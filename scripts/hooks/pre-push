#!/bin/bash
# Before a push: the pre-commit checks plus the whole test suite (AGENTS.md).
# Do not bypass with --no-verify; fix the problem before pushing.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
scripts/hooks/pre-commit
echo "pre-push: cargo clippy -D warnings, cargo test --workspace --release"
cargo clippy --workspace --all-targets --quiet -- -D warnings
# Release: the AI's series tests take minutes in a debug build.
cargo test --workspace --release --quiet
